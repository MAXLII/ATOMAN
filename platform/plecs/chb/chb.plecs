"= 10e3\npwm_ts = 1/pwm_freq\ncarrier_min = 0\ncarrier_max = 1\ncarrier_duty ="
" 0.5\npwm_phase_1 = 0;\npwm_phase_2 = 1/6;\npwm_phase_3 = 1/3;\n\npwm_delay_1"
" = pwm_phase_1 * pwm_ts;\npwm_delay_2 = pwm_phase_2 * pwm_ts;\npwm_delay_3 = "
"pwm_phase_3 * pwm_ts;\n\npwm_dead_time = 2e-6\npwm_dead_ratio = pwm_dead_time"
"/pwm_ts\n\nsample_rate = ctrl_ts/8\n\ngrid_freq = 50\ngrid_v_rms = 6000\ngrid"
"_v_peak = sqrt(2)*grid_v_rms\nl_input = 12e-3\nr_input_model = 1e-3\n\ncell_c"
"ount = 3\nc_bus = 600e-6\nv_bus_init = 3200\nv_bus_ref = 3200\nr_load_1 = 512"
