{
    "files.associations": {
        "*.bat": "bat",
        "my_math.h": "c",
        "string.h": "c",
        "ac_loss_det.h": "c",
        "core_cm33.h": "c",
        "gd32g5x3_libopt.h": "c"
    },
    "cmake.ignoreCMakeListsMissing": true,
    "extensions.experimental.affinity": {
        "maxli.c-sizeof-hover": 1
    },
    "files.watcherExclude": {
        "**/references/**": true,
        "**/.Xil/**": true,
        "**/.indexes/**": true,
        "**/RemoteSystemsTempFiles/**": true,
        "build/**": true,
        "platform/**/build/**": true,
        "platform/**/build*/**": true
    },
    "search.exclude": {
        "**/references/**": true,
        "**/.Xil/**": true,
        "**/.indexes/**": true,
        "**/RemoteSystemsTempFiles/**": true,
        "build/**": true,
        "platform/**/build/**": true,
        "platform/**/build*/**": true
    },
    "C_Cpp.files.exclude": {
        "**/references/**": true,
        "**/.Xil/**": true,
        "**/.indexes/**": true,
        "**/RemoteSystemsTempFiles/**": true,
        "build/**": true,
        "platform/**/build/**": true,
        "platform/**/build*/**": true
    },
    "C_Cpp.codeAnalysis.exclude": {
        "**/references/**": true,
        "**/.Xil/**": true,
        "**/.indexes/**": true,
        "**/RemoteSystemsTempFiles/**": true,
        "build/**": true,
        "platform/**/build/**": true,
        "platform/**/build*/**": true
    },
    "C_Cpp.workspaceParsingPriority": "medium",
    "C_Cpp.intelliSenseCacheSize": 1024
}
